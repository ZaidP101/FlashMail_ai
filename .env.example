# AI provider (Groq) — only the API key changes between environments.
GROQ_API_KEY=
# Optional: override the model. Defaults to openai/gpt-oss-120b if unset.
AI_MODEL=

# Supabase (for Express API backend) — project URL, NOT the db.* host
SUPABASE_URL=https://qlimwizrubfwtmwsovie.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Supabase (for Next.js admin frontend) — project URL
NEXT_PUBLIC_SUPABASE_URL=https://qlimwizrubfwtmwsovie.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Express API URL (for Next.js rewrites — defaults to http://localhost:8081)
API_URL=http://localhost:8081

# Express API URL for direct browser calls (admin frontend).
# Set in production deploys (e.g. https://api.zaidp101.tech); leave unset for local dev,
# where the next.config.ts rewrite above proxies /api/* instead.
NEXT_PUBLIC_API_URL=